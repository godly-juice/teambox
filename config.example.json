{
  "bind": "127.0.0.1",
  "port": 8740,
  "data_dir": "/var/lib/teambox",
  "public_url": "https://team.xseed.ing",
  "admin_emails": [],
  "dev_mode": false,
  "trusted_proxy_ips": ["127.0.0.1", "::1"],
  "auth": {"invite_hours": 48, "invite_max_tries": 5, "pin_min": 6, "account_max_fails": 5, "lock_minutes": 15,
           "ip_max_fails": 20, "ip_window_minutes": 15, "ip_block_minutes": 30, "idle_minutes": 240, "absolute_hours": 72,
           "cookie_secure": true, "id_domain": "team.xseed.ing"},
  "access": {
    "enabled": false,
    "team_domain": "",
    "aud": "",
    "require_jwt": true
  },
  "welcome": {"model": ""},
  "vault": {"file_max_mb": 25, "member_max_mb": 500},
  "gateway": {
    "url": "http://REPLACE-BESNIK-LAN-IP:11540",
    "secret_file": "/etc/teambox/gateway.secret",
    "timeout_s": 600
  },
  "builds": {"max_total": 2, "max_steps": 40, "max_minutes": 60, "max_tokens": 2500},
  "jail": {"mode": "bwrap", "bwrap": "/usr/bin/bwrap", "prlimit": "/usr/bin/prlimit", "systemd_scope": false,
           "memory_mb": 1024, "timeout_s": 120, "max_procs": 256, "max_file_mb": 50},
  "limits": {"sandboxes_per_member": 10, "sandbox_max_mb": 200, "git_max_push_mb": 50, "chat_messages_max": 200, "tokens_per_member": 5},
  "feeds": {"max_file_mb": 95, "member_quota_mb": 1000, "max_files_per_post": 10, "post_max_chars": 10000, "comment_max_chars": 4000,
            "pending_hours": 24},
  "comms": {
    "lumi_public_key": "REPLACE-with-the-SPKI-printed-by-lumi_comms_key.py-on-BESNIK",
    "lumi_kid": "REPLACE-with-the-kid-printed-by-lumi_comms_key.py",
    "export_token_sha256": "REPLACE-with-the-export-token-sha256-printed-by-lumi_comms_key.py",
    "ice_servers": [{"urls": ["stun:REPLACE-turn-host:3478"]}],
    "turn": {"urls": ["turn:REPLACE-turn-host:3478?transport=udp", "turns:REPLACE-turn-host:5349?transport=tcp"],
             "secret_file": "/etc/teambox/turn.secret", "ttl_s": 3600},
    "max_call": 4
  }
}
