[Unit]
Description=Team box (team.xseed.ing) - sandboxes, AI builds, shared models
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=teambox
Group=teambox
ExecStart=/usr/bin/python3 /opt/teambox/run.py --config /etc/teambox/config.json
Restart=on-failure
RestartSec=5
# The whole app (and every jailed test it starts) lives in this cgroup:
MemoryMax=8G
TasksMax=2048
# Hardening. NOT set on purpose: RestrictNamespaces / PrivateUsers (bubblewrap needs unprivileged user namespaces for the jail).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/teambox
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
